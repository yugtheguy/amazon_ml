{
  "schema_version": "v1",
  "description": "C002 Canonical Labeled Candidate-Pair Dataset",
  "composite_key": [
    "entity_id_s1",
    "candidate_source",
    "entity_id_cand"
  ],
  "source_aware_identity": true,
  "valid_candidate_sources": [
    "S2",
    "S3"
  ],
  "label_definition": "label=1 iff (candidate_source, entity_id_cand) is in official GT for entity_id_s1. Source: train_ground_truth.tsv ONLY. No heuristics.",
  "fold_semantics": "Fold is inherited from folds_v1.parquet via entity_id_s1. One S1 entity → exactly one fold. Never inferred from pairs.",
  "column_categories": {
    "A_identity": [
      "entity_id_s1",
      "candidate_source",
      "entity_id_cand"
    ],
    "A_core_metadata": [
      "country",
      "fold"
    ],
    "A_provenance_optional": [
      "retrieved_exact",
      "retrieved_name_word",
      "retrieved_address_word",
      "retrieved_rare",
      "retrieved_numeric",
      "exact_name_address_clean",
